# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── AWS Credentials ───────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# For temporary credentials (AWS Academy / SSO) — leave empty if using long-term keys
AWS_SESSION_TOKEN=

# ── Cognito (optional — skip if not using auth) ───────────────────────────────
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
DYNAMODB_USERS_TABLE=medai-users
DYNAMODB_MEDICATIONS_TABLE=medai-medications
DYNAMODB_SCHEDULES_TABLE=medai-schedules
DYNAMODB_DOSE_HISTORY_TABLE=medai-dose-history
DYNAMODB_ALERTS_TABLE=medai-alerts
DYNAMODB_TELEMETRY_TABLE=medai-device-telemetry

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=medai-cabinet-images-daonguyenhp-2311

# ── AWS IoT Core ──────────────────────────────────────────────────────────────
# Endpoint: AWS Console → IoT Core → Settings → Device data endpoint
IOT_ENDPOINT=a3mqc6kvosl0e0-ats.iot.ap-southeast-1.amazonaws.com
# Paths relative to backend/ working directory
IOT_CERT_PATH=certs/medai-cabinet-device.cert.pem
IOT_KEY_PATH=certs/medai-cabinet-device.private.key
IOT_CA_PATH=certs/AmazonRootCA1.pem
IOT_CLIENT_ID=medai-backend-server

# ── SNS ───────────────────────────────────────────────────────────────────────
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:521330944778:medai-alerts
SNS_CAREGIVER_TOPIC_ARN=arn:aws:sns:ap-southeast-1:521330944778:medai-caregiver

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
# Llama 3 (available in AWS Academy):
BEDROCK_MODEL_ID=meta.llama3-1-8b-instruct-v1:0
# Claude 3 (if you have access):
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
